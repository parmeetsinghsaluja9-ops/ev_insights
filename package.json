{
  "name": "tableau-superstore-project",
  "version": "1.0.0",
  "description": "Tableau vocational training project: Superstore sales and profitability analysis (static site + data tooling)",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean_data.js",
    "analyze": "node scripts/analyze_data.js",
    "excel": "node scripts/build_excel.js",
    "build": "node scripts/build_site_data.js",
    "perf": "node performance_testing/analyze_results.js",
    "perf:data": "node performance_testing/prepare_datasets.js",
    "test": "node --test tests/*.test.js",
    "serve": "node scripts/serve.js",
    "all": "npm run clean && npm run analyze && npm run excel && npm run build && npm test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
